+  if IsBloodElfUnit(member.unit) and not HasArcaneTorrent(ordered) then
+    local racial = ArcaneTorrentCapability(ARCANE_TORRENT_DEFAULT_ID, nil, true)
+    merged[racial.id] = racial
+    ordered[#ordered + 1] = racial
+  end
+
+  return peer, ordered
+end
