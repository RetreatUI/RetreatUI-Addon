diff -ruN b22_base/RetreatUI/Automation/AutoRoleCheck.lua v111_final/RetreatUI/Automation/AutoRoleCheck.lua
--- b22_base/RetreatUI/Automation/AutoRoleCheck.lua	2026-07-29 19:18:39.000000000 +0000
+++ v111_final/RetreatUI/Automation/AutoRoleCheck.lua	2026-07-29 21:34:35.815333434 +0000
@@ -112,4 +112,30 @@
     end
 end
 
+function AutoRoleCheck:OpenOptions()
+    CreateOptionsPanel()
+
+    if _G.Settings and type(_G.Settings.OpenToCategory) == "function" and self.category then
+        local categoryID = self.category
+        if type(categoryID) == "table" then
+            if type(categoryID.GetID) == "function" then
+                categoryID = categoryID:GetID()
+            else
+                categoryID = categoryID.ID or categoryID.id or categoryID
+            end
+        end
+        _G.Settings.OpenToCategory(categoryID)
+        return true
+    end
+
+    if type(InterfaceOptionsFrame_OpenToCategory) == "function" and self.panel then
+        -- The legacy options frame occasionally needs two calls to scroll to addon panels.
+        InterfaceOptionsFrame_OpenToCategory(self.panel)
+        InterfaceOptionsFrame_OpenToCategory(self.panel)
+        return true
+    end
+
+    return false
+end
+
 CreateOptionsPanel()
diff -ruN b22_base/RetreatUI/CHANGELOG.txt v111_final/RetreatUI/CHANGELOG.txt
--- b22_base/RetreatUI/CHANGELOG.txt	2026-07-29 20:36:29.000000000 +0000
+++ v111_final/RetreatUI/CHANGELOG.txt	2026-07-29 21:34:35.819333434 +0000
@@ -1,189 +1,28 @@
-RetreatUI v1.0.11-beta.22
-- Added Bloodmage Trail of Blood proc tracking using verified spell ID 804859.
-- Trail of Blood now appears in the Procs/Buffs row with its remaining five-second duration.
-- Preserved Enraging Howl and all beta.21 behavior without duplicate trackers.
-
-RetreatUI v1.0.11-beta.21
-- Fixed Bloodmage Enraging Howl proc tracking by using the verified live aura name and spell ID 504157.
-- Enraging Howl now appears in the Bloodmage Procs/Buffs row with its remaining duration.
-- Retained the plural aura-name alias for compatibility without creating a duplicate tracker.
-
-RetreatUI v1.0.11-beta.20
-- Added native Auto Accept Role Checks automation without WeakAuras, minimap buttons or chat output.
-- Added Bloodmage Vanthir's Gift (1219817) to Procs/Buffs tracking.
-
-RetreatUI v1.0.11-beta.19
-- Starcaller: replaced Scattered/Shattered Stars target debuff bars with a dedicated 8-segment target-bound resource tracker.
-- The tracker resets immediately on target changes, reads only the player's target aura and stays hidden without a valid hostile target.
-- Scattered Stars now uses the central class-resource row at Y -118 with a compact STARS count below it and no HUD overlap.
-- Lunar Phase and Lunar Charge remain in the normal Procs/Buffs row.
-- Removed Scattered Stars variants from the target-frame debuff list and TurboPlates target-debuff whitelist.
-
-RetreatUI v1.0.11-beta.16
-- Bloodmage Buff Manager: Slaughterhouse Offering is now a choice inside the single exclusive Offering family.
-- Removed the accidental standalone Slaughterhouse Offering assignment column from beta.15.
-- Migrates beta.15 Slaughterhouse assignments into the unified Offering family automatically.
-- TurboPlates: mana-blue coloring now requires direct live-unit mana type plus a real mana pool.
-- Removed broad frame/text/power heuristics that could make every recycled nameplate blue.
-- Stale beta.15 blue overlays are restored automatically on non-mana units.
-
-RetreatUI v1.0.11-beta.15
-- Rebuilt the Buff Manager around one generic coverage planner for every class buff.
-- All player buffs are scanned by exact aura, spell ID and equivalent effect family before a buff is marked missing.
-- Equivalent buffs supplied by other classes now satisfy the matching Buff Manager row and prevent duplicate recommendations.
-- Exclusive multi-choice families such as Bloodmage Offerings and Marks of Xoroth keep any active family member and dynamically select the best uncovered learned choice only when none is active.
-- Automatic assignments prefer the learned buff that fills the most currently uncovered effects, while manual assignments remain respected.
-- Slaughterhouse Offering (spell 1108493) remains assigned to the Bloodmage Buff Manager.
-- TurboPlates mana coloring now scans the visible nameplate tree and matches StatusBars against the unit's live health values, instead of coloring only the hidden reserve healthbar.
-- The TurboPlates diagnostic now reports visible live healthbar and overlay counts.
-
-RetreatUI v1.0.11-beta.14
-- Added Slaughterhouse Offering (spell 1108493) to the Bloodmage Buff Manager.
-- TurboPlates mana coloring no longer depends on access to TurboPlates private namespace data.
-- Blue mana fill is created directly on the resolved TurboPlates health StatusBar, even when the custom plate reports hidden during Ascension frame assignment.
-- Updated the one-time diagnostic to report the direct nameplate, plate, healthbar, visibility and overlay state.
-
-RetreatUI v1.0.11-beta.13
-- TurboPlates mana health bars now use TurboPlates' private exact unit-to-plate map.
-- Blue fill overlay moved above the native StatusBar fill and is refreshed after every TurboPlates color update.
-- Added one-time target diagnostic for mana nameplate linkage during beta testing.
-- Added Demonfire Pact (spell 800031) to the Felsworn Buff Manager.
-
-RetreatUI v1.0.11-beta.12
-
-- Fixed TurboPlates mana-enemy health bars not turning blue on Ascension nameplate units.
-- Mana detection now checks the actual mana pool before relying on UnitPowerType.
-- Added an independent blue fill overlay that follows the live health fill and cannot be overwritten by TurboPlates threat colors.
-- Retains the single Totem Bar mover and all beta.11 class tracking changes.
-
